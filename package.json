{
  "name": "delta-force-harmonica-tiles",
  "private": true,
  "version": "1.0.6",
  "description": "Guide thổi harmonica trong Delta Force kiểu Piano Tiles — web app tĩnh, chạy offline, không server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nienlequang/df-harmonica-tiles.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --prod"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
